# Copy this file to .env and fill it in.

# Your domain (no https://, no www). Used by Caddy for HTTPS.
SITE_DOMAIN=gilscustoms.com

# Where contact form messages are sent.
MAIL_TO=david@gilscustoms.com

# Address the emails come from. Must be allowed by your SMTP provider.
MAIL_FROM=david@gilscustoms.com

# SMTP settings. See README.md for Gmail / Zoho / Brevo examples.
# If SMTP_HOST is empty, messages are only saved to data/submissions.jsonl.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Send the customer an automatic "thanks, I got your message" email.
AUTO_REPLY=true

# Cloudflare Turnstile spam check for the contact forms (free).
# The site key (public) is built in; paste the widget's SECRET key here from
# Cloudflare dashboard -> Turnstile -> your widget -> Settings. Leave it empty
# to turn the check off. Never commit or share the secret key.
TURNSTILE_SECRET_KEY=
# Only needed if you use a different widget or extra domains:
# TURNSTILE_SITE_KEY=
# TURNSTILE_HOSTNAMES=gilscustoms.com,www.gilscustoms.com
